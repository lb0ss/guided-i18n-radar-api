# Copy to .env (git-ignored) and fill in what you use. Everything is optional for the daily checks.

# Bake-off and, later, research and drafting
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
I18N_CORE_PATH=~/repos/i18n-ai-core   # the extension's repo: docs/FACTS.md and the CHANGELOG

# Stats: dev.to page views (dev.to → Settings → Extensions → DEV Community API Keys)
DEV_API_KEY=
# Higher GitHub rate limits (not needed at one check a day)
GITHUB_TOKEN=

# Digest by email (for Gmail: an app password, smtp.gmail.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Digest as a phone notification (pushover.net)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# X (optional, paid per post returned, prepaid credit at developer.x.com). With a token, checks
# watch replies to and mentions of you, and research can search X. Radar stops reading X for the
# month at the limit (600 posts is about $3 at $0.005 a post).
X_BEARER_TOKEN=
X_MONTHLY_POST_LIMIT=600
